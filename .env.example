# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only closed authentication and financial API configuration.
# Use the existing Contas Tatu finance_v2 database, never a VITE_ variable.
CONTAS_TATU_DATABASE_URL=""
CONTAS_TATU_APP_ORIGIN=""

# Optional operator-only Neon management API. Never configure with VITE_ names.
# These variables do not enable public HTTP routes or run backups automatically.
CONTAS_TATU_NEON_API_KEY=""
CONTAS_TATU_NEON_PROJECT_ID="small-dream-79132114"
CONTAS_TATU_NEON_BRANCH_ID="br-purple-tree-b7rcasev"
